# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Node
web/node_modules/
web/dist/
web/package-lock.json
web/bundle-report.html

# Data files (too large for git)
works/
_inbox/
_duplicates/
_quarantine/
_archive/
/views/

# Markdown documents: design docs ARE tracked (README, FUTURE_WORK_PLAN,
# TECHNICAL_OVERVIEW, docs/**). Only ignore historical/autogenerated reports.
literature_report.md
migration_report.md

# Keep archived documentation tracked even when filenames match old root reports.
!docs/_archive/
!docs/_archive/**

# Log files
*.log

# Database & JSON data
*.sqlite*
*.db
literature_library.db
index.json
parse_ledger.json
dedup_reviews.json
literature_inventory.json
migration_plan.json
migration_plan.dryrun.json

# Internal directories
.claude/
PROJECT_INDEX/
templates/backups/

# IDE
.vscode/
.idea/
.codebuddy/

# OS
Thumbs.db
Desktop.ini
.DS_Store

# One-time scripts and scan results
scripts/_*.py
scripts/_scan_results.json
!scripts/_archive/
!scripts/_archive/README.md
!scripts/_archive/*.py

# Documentation assets
docs/issues/screenshots/

# Secrets (MinerU API token etc.)
.env

# LLM 裁判调用日志（运行时，含 token 计数）
llm_judge_calls.jsonl

# Phase B 隔离试跑产物（运行时，不入 VCS）
_cloud_trial/

# collector runtime cache (PDFs staged for ingestion)
_collector_cache/

# Codex/agent temp working directory
.codex_tmp/

# Parser archive large files (diffs, binary docs)
parser/docs/archive/latest_changes.diff
