% [05] DeceptionBench: A Comprehensive Benchmark for AI Deception Behaviors i
%     library: W-sha-6bb2ad8fb52a
@inproceedings{ref05,
  title = {{DeceptionBench: A Comprehensive Benchmark for AI Deception Behaviors in Real-world Scenarios}},
  author = {Yao Huang and Yitong Sun and Yichi Zhang and Ruochen Zhang and Yinpeng Dong and Xingxing Wei},
  year = {2025},
  booktitle = {NeurIPS 2025 Datasets and Benchmarks Track},
  eprint = {2510.15501},
  archiveprefix = {arXiv},
  url = {https://arxiv.org/abs/2510.15501},
  abstract = {Despite remarkable advances of LLMs, rapid enhancement of capabilities introduces emergent deception behaviors that may induce severe risks in high-stakes deployments. We establish DeceptionBench, the first benchmark that systematically evaluates how deceptive tendencies manifest across different societal domains. The benchmark encompasses 150 scenarios in five domains with over 1,000 samples. Extensive experiments reveal critical vulnerabilities, particularly amplified deception under reinforcement dynamics.}
}
% [06] AI Sandbagging: Language Models Can Strategically Underperform on Eval
%     library: W-sha-9b9793d6c035
@article{ref06,
  title = {{AI Sandbagging: Language Models Can Strategically Underperform on Evaluations}},
  author = {Teun van der Weij and Felix Hofstatter and Oliver Jaffe and Samuel F. Brown and Francis Rhys Ward},
  year = {2025},
  journal = {ICLR 2025},
  eprint = {2406.07358},
  archiveprefix = {arXiv},
  url = {https://arxiv.org/abs/2406.07358},
  abstract = {Trustworthy capability evaluations are crucial for ensuring AI safety. However, developers or the AI system itself may have incentives for evaluations to understate actual capability. We define sandbagging as strategic underperformance on an evaluation. We assess sandbagging capabilities in contemporary language models, finding that frontier LMs can selectively underperform on dangerous capability evaluations while maintaining performance on general evaluations. Models can also be fine-tuned to hide specific capabilities unless given a password.}
}
