% [31] The MASK Benchmark: Disentangling Honesty From Accuracy in AI Systems
%     library: W-sha-38afe4bbff08
@inproceedings{ref31,
  title = {{The MASK Benchmark: Disentangling Honesty From Accuracy in AI Systems}},
  author = {Richard Ren and Arunim Agarwal and Mantas Mazeika and Cristina Menghini and Dan Hendrycks},
  year = {2026},
  booktitle = {arXiv preprint},
  eprint = {2503.03750},
  archiveprefix = {arXiv},
  url = {https://arxiv.org/abs/2503.03750},
  abstract = {We introduce MASK, a benchmark for measuring lies of commission in LLMs. We develop a novel evaluation pipeline that directly measures when models lie by eliciting their underlying beliefs and testing whether models will contradict those beliefs when pressured to lie. We evaluate 30 widely-used frontier LLMs and find that while larger models obtain higher accuracy, they do not become more honest. Most frontier LLMs obtain high scores on truthfulness benchmarks yet exhibit a substantial propensity to lie under pressure.}
}
