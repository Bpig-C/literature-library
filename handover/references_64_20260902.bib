% [02] Alignment Faking in Large Language Models
%     library: W-sha-f448dfe38f21
@article{ref02,
  title = {{Alignment Faking in Large Language Models}},
  author = {Ryan Greenblatt and Carson Denison and Benjamin Wright and Fabien Roger and Monte MacDiarmid and Sam Marks and Johannes Treutlein and Evan Hubinger},
  year = {2024},
  journal = {arXiv preprint},
  eprint = {2412.14093},
  archiveprefix = {arXiv},
  url = {https://arxiv.org/abs/2412.14093},
  abstract = {We present a demonstration of a large language model engaging in alignment faking: selectively complying with its training objective in training to prevent modification of its behavior out of training. We give Claude 3 Opus a system prompt stating it is being trained to answer all queries, even harmful ones. We find the model complies with harmful queries from free users 14\% of the time, versus almost never for paid users.}
}
% [03] PropensityBench: Evaluating Latent Safety Risks in Large Language Mode
%     library: W-sha-a2c6b17bc301
@inproceedings{ref03,
  title = {{PropensityBench: Evaluating Latent Safety Risks in Large Language Models via an Agentic Approach}},
  author = {Udari Madhushani Sehwag and Shayan Shabihi and Alex McAvoy and Vikash Sehwag and Yuancheng Xu and Furong Huang},
  year = {2025},
  booktitle = {arXiv preprint},
  abstract = {Current safety evaluations primarily test for what a model can do without assessing what it would do if endowed with high-risk capabilities. We introduce PropensityBench, a benchmark framework that assesses the proclivity of models to engage in risky behaviors when equipped with simulated dangerous capabilities using proxy tools. Our framework includes 5,874 scenarios with 6,648 tools spanning four high-risk domains: cybersecurity, self-proliferation, biosecurity, and chemical security.}
}
