{
  "output": {
    "filePath": "PROJECT_INDEX/history/document-parser_{datetime}.md",
    "style": "markdown",
    "showDirectoryStructure": true
  },
  "compression": {
    "enabled": true,
    "keepSignatures": true,
    "keepDocstrings": true,
    "keepInterfaces": true
  },
  "ignore": {
    "customPatterns": [
      "**/*.md",
      "**/*.json",
      "**/*.html",
      "**/*.pdf",
      "**/*.log",
      "**/*.pyc",
      "**/*.db",
      "**/*.sqlite",
      "**/*.drawio",
      "**/*.lock",
      "html/vendor/**",
      "Datas/**",
      "logs/**",
      ".codex_tmp/**",
      ".venv/**",
      "venv/**",
      "__pycache__/**",
      "PROJECT_INDEX/history/**",
      ".*/**"
    ],
    "useGitignore": true,
    "useDefaultIgnore": true
  }
}




